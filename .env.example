# Backend environment variables (api/, app/, scripts/).
# Copy to .env and fill in with your own values — never commit the real file.

# ── AI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key

# ── Supabase ─────────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project Settings → Database → Connection string (session pooler recommended)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# ── Threat collector alerting (scripts/run_collector.py) ─────────────────
ALERT_EMAIL_FROM=alerts@yourorg.com
ALERT_EMAIL_TO=security@yourorg.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourorg.com
SMTP_PASSWORD=your-smtp-app-password
ALERT_MODE=digest
# digest = one summary email per run, individual = one email per incident

# Optional — Slack alerting alongside email
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
