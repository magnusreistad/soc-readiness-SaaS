# Environment variables for the PUBLIC DEMO deployment only.
# Copy to .env.demo (git-ignored) and fill in with the DEMO Supabase
# project's own values — this must be a separate Supabase project from
# the one in your real .env, never the same one.

# ── Demo Supabase project (used by scripts/seed_demo_data.py) ────────────
DEMO_SUPABASE_URL=https://your-demo-project-ref.supabase.co
DEMO_SUPABASE_SERVICE_ROLE_KEY=your-demo-project-service-role-key
DEMO_SUPABASE_DB_URL=postgresql://postgres.your-demo-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# ── Demo API deployment (api/, same FastAPI app, pointed at the demo project) ─
# The demo hosting environment's .env should set the usual SUPABASE_URL /
# SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_DB_URL to the demo
# project's values (NOT the DEMO_-prefixed ones above, which are only read by
# the seed script), plus:
DEMO_MODE=true
DEMO_ORG_ID=
# ^ the org id printed by scripts/seed_demo_data.py after seeding

# ── Demo frontend deployment (frontend/.env.local on the demo hosting) ───
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY should point at the
# demo Supabase project. These two enable the "View Demo" button on /login:
NEXT_PUBLIC_DEMO_EMAIL=demo@meridianhealthpartners-demo.com
NEXT_PUBLIC_DEMO_PASSWORD=DemoReadOnly2026!

#OPENAI API KEY with a spending cap as a safety net for the demo. You can create a new API key in your OpenAI account and set a spending limit on it. This is important to prevent abuse of the demo environment.
OPENAI_API_KEY=insert-your-openai-api-key-here

